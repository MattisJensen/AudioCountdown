{
  "manifest_version": 2,
  "name": "Audio Countdown Media Control",
  "version": "1.2.2",
  "description": "Lets Audio Countdown pause and resume supported web music players.",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-control@audio-countdown.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://music.apple.com/*",
    "https://open.spotify.com/*",
    "https://*.youtube.com/*",
    "https://soundcloud.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://music.apple.com/*",
        "https://open.spotify.com/*",
        "https://*.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "js": ["media-control.js", "spotify-control.js", "media-content.js"],
      "run_at": "document_idle"
    }
  ]
}
